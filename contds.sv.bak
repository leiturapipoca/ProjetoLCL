module contds (
    input  logic clk,          // vem do inc do contador de centésimos (1 pulso a cada 100 ms)
    output logic [3:0] q,      // saída: de 0 a 9
    output logic inc           // pulso quando q atinge 9 e reinicia (para acionar segundos, por exemplo)
);

always_ff @(posedge clk) begin
    if (q == 9) begin
        q   <= 0;
        inc <= 1;
    end else begin
        q   <= q + 1;
        inc <= 0;
    end
end

endmodule
