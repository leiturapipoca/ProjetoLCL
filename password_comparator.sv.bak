module password_comparator (
    input  logic        clk,            // Clock genérico
    input  logic [5:0]  gabarito,       // Senha correta (6 bits)
    input  logic [5:0]  resposta,       // Tentativa atual (6 bits)
    input  logic        enter,          // Sinal de enter (botão físico)
    output logic [5:0]  LEDR            // Saída para LEDs (nome específico da DE2)
);

    // Sinais internos
    logic enter_debounced;
    logic enter_pulse;
    logic [5:0] resultado;
    logic [2:0] correct_count;  // Contador de 0-6 bits corretos

    // -- Debouncer para o botão enter --
    debounce debouncer (
        .clk(clk),
        .button_in(enter),
        .button_out(enter_debounced)
    );

    // -- Detector de borda de subida --
    always_ff @(posedge clk) begin
        logic enter_prev;
        enter_prev <= enter_debounced;
        enter_pulse <= enter_debounced && !enter_prev;
    end

    // -- Lógica de comparação --
    always_comb begin
        correct_count = '0;
        for (int i = 0; i < 6; i++) begin
            if (gabarito[i] == resposta[i]) begin
                correct_count++;
            end
        end
    end

    // -- Registra resultado apenas no pulso do enter --
    always_ff @(posedge clk) begin
        if (enter_pulse) begin
            resultado <= '0;  // Limpa resultado anterior
            for (int i = 0; i < correct_count; i++) begin
                resultado[i] <= 1'b1;  // Acende LEDs progressivos
            end
        end
    end

    // Saída para os LEDs da DE2
    assign LEDR = resultado;

endmodule

// -- Módulo Debouncer --
module debounce (
    input  logic clk,
    input  logic button_in,
    output logic button_out
);
    parameter DEBOUNCE_MS = 20;       // 20ms de debounce
    parameter CLK_FREQ = 50_000_000;   // 50MHz
    
    localparam COUNTER_MAX = DEBOUNCE_MS * (CLK_FREQ / 1000);
    logic [$clog2(COUNTER_MAX)-1:0] counter;
    logic button_state;

    always_ff @(posedge clk) begin
        if (button_in != button_state) begin
            button_state <= button_in;
            counter <= 0;
        end else if (counter < COUNTER_MAX-1) begin
            counter <= counter + 1;
        end else begin
            button_out <= button_state;
        end
    end
endmodule